{
  "name": "vite-ts-component",
  "version": "1.0.0",
  "private": true,
  "description": "cjx-zdy-ui monorepo",
  "scripts": {
    "ui:build": "gulp -f packages/components/script/build/gulpfile.ts",
    "ui:dev": "pnpm run --filter ./examples dev",
    "utils:build": "pnpm run --filter ./packages/utils build",
    "docs:dev": "pnpm run --filter ./docs docs:dev",
    "docs:build": "pnpm run --filter ./docs docs:build",
    "docs:deploy": "node ./deploy.mjs",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "format": "prettier --write \"./**/*.{html,vue,ts,js,json,md}\""
  },
  "keywords": [],
  "author": "陈佳鑫",
  "license": "ISC",
  "devDependencies": {
    "@types/gulp": "^4.0.11",
    "@types/gulp-autoprefixer": "^0.0.34",
    "@types/node": "^20.3.0",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^36.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^9.15.1",
    "fast-glob": "^3.2.12",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-sass": "^5.1.0",
    "prettier": "^2.8.8",
    "sass": "^1.77.0",
    "sucrase": "^3.32.0",
    "typescript": "^5.1.3"
  }
}
